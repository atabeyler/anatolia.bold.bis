# Backend (server/)
PORT=8080
RUST_LOG=info

# Falls back to a local SQLite file (server/data/dev.db) if unset.
DATABASE_URL=postgres://anatolia:anatolia@localhost:5432/anatolia_bis

# Fall back to fixed local-development values if unset. In production
# (NODE_ENV=production, or RENDER — set automatically on Render), these
# are REQUIRED and must each be at least 32 bytes of random data — the
# app refuses to start otherwise. Generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Separate from the two above — signs the registration approve/reject
# email links only. Same production requirement (required, >= 32 bytes).
APPROVAL_TOKEN_SECRET=change-me-as-well

# Separate again — signs short-lived login-time MFA challenge tokens only.
# Same production requirement (required, >= 32 bytes).
MFA_TOKEN_SECRET=change-me-as-well-too

# Comma-separated roles that must enroll TOTP MFA before login can
# complete. Defaults to SYSTEM_ADMIN,SECURITY_ADMIN,REVIEWER; set to an
# empty value to disable mandatory MFA (voluntary enrollment stays
# available regardless).
# MFA_REQUIRED_ROLES=SYSTEM_ADMIN,SECURITY_ADMIN,REVIEWER

# AES-256-GCM key (64 hex characters = 32 bytes) encrypting national ID
# numbers at rest. Same production requirement (required, exactly 32
# bytes once hex-decoded). Generate with `openssl rand -hex 32`.
NATIONAL_ID_ENCRYPTION_KEY=change-me-64-hex-characters

# Four-eyes review: when true, a candidate's first confirm/reject decision
# only moves it to "needs_second_review" — a second, different reviewer's
# decision finalizes it. Defaults to false.
# REQUIRE_SECOND_REVIEW=true

# Set to true only behind a reverse proxy you control that sets
# X-Forwarded-For itself. Defaults to true in production and false locally.
# TRUST_PROXY=true

# How many ranked candidates a search returns by default, and the hard
# ceiling a client-requested topK is clamped to. Defaults: 10 and 50.
# SEARCH_DEFAULT_TOP_K=10
# SEARCH_MAX_TOP_K=50

# BiometricProvider selection: "mock" (default, no real face comparison)
# or "onnx" (real YuNet/SFace pipeline via ONNX Runtime). Any other value
# fails startup. Production refuses to start with mock unless
# ALLOW_MOCK_BIOMETRICS=true is explicitly set.
# BIOMETRIC_PROVIDER=mock
# ALLOW_MOCK_BIOMETRICS=true

# Local cache directory for BIOMETRIC_PROVIDER=onnx's downloaded model files.
# MODEL_CACHE_DIR=./data/models

# OSINT/evidence providers. Every configured real provider in a class runs;
# one configured provider does not suppress another. Mock web/news providers
# are used only when that class has no real provider configured.
#
# Text web sources:
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
#
# News/publication sources:
# CURRENTS_API_KEY=
# NEWS_API_KEY=
#
# Direct reverse-image/public-web sources. All configured sources run against
# the same sanitized probe image; results remain separate evidence signals.
# TINEYE_API_KEY=
# GOOGLE_CLOUD_VISION_API_KEY=
# YANDEX_SEARCH_API_KEY=
# YANDEX_SEARCH_FOLDER_ID=

# When true, a completed biometric search automatically runs configured
# reverse-image sources against the sanitized probe and web/news sources
# against eligible candidate context. Defaults to false.
# AUTO_OSINT_AFTER_BIOMETRIC_SEARCH=false
#
# Upper bound on how many top-scoring candidates automatic text-source
# enrichment runs against. Defaults to 5.
# OSINT_AUTO_MAX_CANDIDATES=5

# Optional bearer token gating GET /metrics.
# METRICS_TOKEN=

# Required together to bootstrap the first SYSTEM_ADMIN account via
# POST /api/v1/admin/seed-admin. The endpoint self-disables once an active
# SYSTEM_ADMIN exists; BOOTSTRAP_ENABLED=true deliberately re-opens it.
ADMIN_SEED_TOKEN=change-me
ADMIN_USER_CODE=ADMIN01
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=info@boldkimya.com.tr
# BOOTSTRAP_ENABLED=true

# Set to false to disable the periodic self-ping that keeps a Render
# free-plan instance warm (no effect outside Render).
# ENABLE_SELF_PING=false

# Optional: registration/approval emails are silently skipped if unset.
RESEND_API_KEY=
RESEND_FROM=Anatolia B.I.S. <onboarding@resend.dev>
APP_URL=http://localhost:8080

# Only needed if the built frontend lives somewhere other than the default.
# STATIC_DIR=../client/dist

# Frontend (client/) — only needed when running the frontend dev server
# against a backend on a different origin.
VITE_API_BASE_URL=http://localhost:8080/api

# Only needed for that same cross-origin local dev case.
ALLOWED_ORIGINS=http://localhost:5173
