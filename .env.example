# Backend (server/)
PORT=8080
RUST_LOG=info

# Falls back to a local SQLite file (server/data/dev.db) if unset.
DATABASE_URL=postgres://anatolia:anatolia@localhost:5432/anatolia_bis

# Fall back to fixed local-development values if unset. In production
# (NODE_ENV=production, or RENDER — set automatically on Render), these
# are REQUIRED and must each be at least 32 bytes of random data — the
# app refuses to start otherwise. Generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Separate from the two above — signs the registration approve/reject
# email links only. Same production requirement (required, >= 32 bytes).
APPROVAL_TOKEN_SECRET=change-me-as-well

# Separate again — signs short-lived login-time MFA challenge tokens only.
# Same production requirement (required, >= 32 bytes).
MFA_TOKEN_SECRET=change-me-as-well-too

# Comma-separated roles that must enroll TOTP MFA before login can
# complete. Defaults to SYSTEM_ADMIN,SECURITY_ADMIN,REVIEWER; set to an
# empty value to disable mandatory MFA (voluntary enrollment stays
# available regardless).
# MFA_REQUIRED_ROLES=SYSTEM_ADMIN,SECURITY_ADMIN,REVIEWER

# AES-256-GCM key (64 hex characters = 32 bytes) encrypting national ID
# numbers at rest. Same production requirement (required, exactly 32
# bytes once hex-decoded). Generate with `openssl rand -hex 32`.
NATIONAL_ID_ENCRYPTION_KEY=change-me-64-hex-characters

# Four-eyes review (madde 15): when true, a candidate's first confirm/
# reject decision only moves it to "needs_second_review" — a second,
# different reviewer's decision is what finalizes it. Defaults to false
# (today's single-reviewer behavior).
# REQUIRE_SECOND_REVIEW=true

# Set to true only behind a reverse proxy you control that sets
# X-Forwarded-For itself (otherwise the header is attacker-controlled and
# must not be trusted for rate limiting / audit IPs). Defaults to true in
# production (Render always fronts the app with a proxy), false locally.
# TRUST_PROXY=true

# How many ranked candidates a search returns by default, and the hard
# ceiling a client-requested topK is clamped to (never rejected, just
# capped). Defaults: 10 and 50.
# SEARCH_DEFAULT_TOP_K=10
# SEARCH_MAX_TOP_K=50

# BiometricProvider selection: "mock" (default, no real face comparison)
# or "onnx" (real YuNet/SFace pipeline via ONNX Runtime — see
# docs/ROADMAP.md Phase 4). Any other value fails startup immediately, in
# every environment. In production, running the mock provider at all
# additionally requires ALLOW_MOCK_BIOMETRICS=true as an explicit,
# conscious override; without it, production refuses to start rather than
# silently serving non-biometric "matches". "onnx" needs no such override
# but downloads and SHA-256-verifies its models at startup — if that fails
# (no network, hash mismatch), startup fails closed rather than silently
# falling back to the mock provider.
# BIOMETRIC_PROVIDER=mock
# ALLOW_MOCK_BIOMETRICS=true

# Local cache directory for BIOMETRIC_PROVIDER=onnx's downloaded model
# files (YuNet, SFace). Defaults to ./data/models.
# MODEL_CACHE_DIR=./data/models

# Optional bearer token gating GET /metrics (Prometheus scrape endpoint).
# Unset means the endpoint is open — the conventional Prometheus scrape
# posture; nothing it exports contains PII. Set this only if this
# deployment prefers not to expose operational counts on an unauthenticated
# path.
# METRICS_TOKEN=

# Required together to bootstrap the first SYSTEM_ADMIN account via
# POST /api/v1/admin/seed-admin. The endpoint self-disables once an active
# SYSTEM_ADMIN already exists; set BOOTSTRAP_ENABLED=true to deliberately
# re-open it for recovery (e.g. every admin account was lost), then unset
# it again.
ADMIN_SEED_TOKEN=change-me
ADMIN_USER_CODE=ADMIN01
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=info@boldkimya.com.tr
# BOOTSTRAP_ENABLED=true

# Set to false to disable the periodic self-ping that keeps a Render
# free-plan instance warm (no effect outside Render).
# ENABLE_SELF_PING=false

# Optional: registration/approval emails are silently skipped if unset.
RESEND_API_KEY=
RESEND_FROM=Anatolia B.I.S. <onboarding@resend.dev>
APP_URL=http://localhost:8080

# Only needed if the built frontend lives somewhere other than the
# default (../client/dist, relative to `server/`, for a local
# `cd server && cargo run`). Render's single-service deploy sets this to
# client/dist itself (see render.yaml).
# STATIC_DIR=../client/dist

# Frontend (client/) — only needed when running the frontend's own dev
# server (`npm run dev`) against a backend on a different origin. Not set
# in production: the backend serves the built frontend from the same
# origin, so the default (same-origin "/api") is always correct there.
VITE_API_BASE_URL=http://localhost:8080/api

# Only needed for that same cross-origin local dev case, so the backend's
# CORS layer accepts requests from the frontend dev server's own origin.
ALLOWED_ORIGINS=http://localhost:5173
